pipeline {
    agent any

    environment {
        APP_NAME = 'jenkins-app'
        BUILD_VERSION = '1.0'
    }

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'test', 'prod'],
            description: 'Select the deployment environment'
        )

        booleanParam(
            name: 'FORCE_FAILURE',
            defaultValue: false,
            description: 'Use this option to test the failure post action'
        )
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code from GitHub'
                sh 'pwd'
                sh 'ls -la'
            }
        }

        stage('Build') {
            steps {
                echo "Building ${env.APP_NAME}"
                echo "Version: ${env.BUILD_VERSION}"
            }
        }

        stage('Test') {
            steps {
                echo "Running tests for ${params.ENVIRONMENT}"

                script {
                    if (params.FORCE_FAILURE) {
                        echo 'FORCE_FAILURE is enabled'
                        sh 'exit 1'
                    } else {
                        echo 'All tests passed successfully'
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploying ${env.APP_NAME}"
                echo "Target Environment: ${params.ENVIRONMENT}"
            }
        }
    }

    post {

        always {
            echo 'POST: always - Pipeline execution completed'
        }

        success {
            echo 'POST: success - Pipeline completed successfully'
        }

        failure {
            echo 'POST: failure - Pipeline failed'
        }

        cleanup {
            echo 'POST: cleanup - Cleanup completed'
        }
    }
}
